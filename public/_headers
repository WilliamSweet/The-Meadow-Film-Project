# Cache policy (rewritten 2026-08-24 — mobile load-speed pass).
#
# Everything here was previously "no-cache, must-revalidate", including the
# content-hashed /_astro/ bundle. That meant a repeat visitor re-fetched or
# re-validated every file on every visit, which is why the site felt as slow
# the second time as the first. Hashed filenames change whenever the content
# changes, so they are safe to cache forever; HTML must never be cached, or
# a deploy would not reach anyone.
#
# `immutable` is a browser directive — Cloudflare's edge follows max-age only.

# Content-hashed by Astro (CSS, JS, fonts). Filename changes on every rebuild.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep stable filenames, so cache for a week and no longer.
/images/*
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

# Hand-written JS is cache-busted with ?v= — a day is plenty.
/js/*
  Cache-Control: public, max-age=86400

# HTML must always be fresh so a deploy is visible immediately.
/
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cloud.umami.is https://tally.so; style-src 'self' 'unsafe-inline' https://tally.so; font-src 'self' https://tally.so; img-src 'self' data: https://tally.so; connect-src 'self' https://formspree.io https://cloud.umami.is https://tally.so; frame-src https://tally.so; frame-ancestors 'none';
