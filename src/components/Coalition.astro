---
import { coalitionStats } from '../coalition-stats';
import { anchorPartners, wallPartners } from '../data/partners';
---
<section class="coalition" id="coalition" aria-labelledby="coalition-heading">
  <div class="container">

    <div class="coalition-header">
      <p class="coalition-eyebrow">The Founding Coalition</p>
      <h2 class="coalition-heading" id="coalition-heading">
        The organizations putting their name behind this film.
      </h2>
      <p class="coalition-intro">
        Founding partners join the movement on record — named in the film, in the
        outreach, and in every conversation this work starts. Here is who is already in.
      </p>
      <p class="coalition-stats">{coalitionStats.foundingPartners} founding partners &middot; {coalitionStats.acresPlanted} acres logged on the HNP Biodiversity Map &middot; {coalitionStats.corridorTowns}+ corridors</p>
    </div>

    <ul class="coalition-list" aria-label="Founding coalition partners">
      {anchorPartners.map((partner) => (
        <li class="coalition-item">
          <div class="coalition-rule" aria-hidden="true"></div>
          {partner.logo && (
            <div class="coalition-logo-wrap">
              <img
                class="coalition-logo"
                src={partner.logo}
                alt={partner.logoAlt}
                loading="lazy"
              />
            </div>
          )}
          {partner.url ? (
            <a
              class="coalition-name coalition-name--link"
              href={partner.url}
              target="_blank"
              rel="noopener"
            >{partner.name}</a>
          ) : (
            <span class="coalition-name">{partner.name}</span>
          )}
          <p class="coalition-descriptor">{partner.descriptor}</p>
        </li>
      ))}
    </ul>

    {wallPartners.length > 0 && (
      <div class="coalition-wall">
        <p class="coalition-wall-label">Joined by</p>
        <ul class="coalition-wall-grid" aria-label="Founding partner organizations">
          {wallPartners.map((partner) => (
            <li class="coalition-wall-item">
              <a
                class="coalition-wall-link"
                href={partner.url}
                target="_blank"
                rel="noopener"
                title={partner.name}
              >
                <img
                  class="coalition-wall-logo"
                  src={partner.logo}
                  alt={partner.logoAlt}
                  loading="lazy"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="coalition-closing">
      More organizations in conversation &mdash;{' '}
      <a href="#founding-partner" class="coalition-closing-link">add your organization before the window closes August&nbsp;13</a>.
    </p>

  </div>
</section>

<style>
  .coalition {
    padding: var(--space-24) 0;
  }

  /* ── Header ─────────────────────────────────────── */
  .coalition-header {
    margin-bottom: var(--space-16);
  }

  .coalition-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-4);
  }

  .coalition-intro {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    opacity: 0.72;
    line-height: 1.6;
    max-width: 60ch;
    margin-bottom: var(--space-5);
    text-wrap: pretty;
  }

  .coalition-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: var(--space-4);
  }

  .coalition-stats {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-earth);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* ── List ───────────────────────────────────────── */
  .coalition-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .coalition-item {
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
  }

  /* ── Rule ───────────────────────────────────────── */
  .coalition-rule {
    width: 100%;
    height: 1px;
    background: var(--color-amber);
    opacity: 0.35;
    margin-bottom: var(--space-6);
  }

  /* ── Logo ───────────────────────────────────────── */
  .coalition-logo-wrap {
    margin-bottom: var(--space-4);
  }

  .coalition-logo {
    display: block;
    height: 64px;
    width: auto;
    max-width: 320px;
    object-fit: contain;
    object-position: left center;
    opacity: 0.9;
    mix-blend-mode: multiply;
  }

  /* ── Name ───────────────────────────────────────── */
  .coalition-name {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 700;
    font-style: normal;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: var(--space-3);
    text-decoration: none;
  }

  .coalition-name--link {
    transition: color var(--duration-base) var(--ease-out-expo);
  }

  .coalition-name--link:hover {
    color: var(--color-earth);
  }

  .coalition-name--link:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ── Descriptor ─────────────────────────────────── */
  .coalition-descriptor {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    opacity: 0.65;
    line-height: 1.55;
    max-width: 60ch;
    text-wrap: pretty;
  }

  /* ── Logo wall — scales to 20–30+ without crowding ─ */
  .coalition-wall {
    margin-top: var(--space-16);
    padding-top: var(--space-10);
    border-top: 1px solid rgba(184, 144, 74, 0.35);
  }

  .coalition-wall-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-8);
  }

  .coalition-wall-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-10) var(--space-8);
    align-items: center;
  }

  .coalition-wall-item {
    display: flex;
    justify-content: center;
  }

  .coalition-wall-link {
    display: block;
    line-height: 0;
    opacity: 0.72;
    transition: opacity var(--duration-base) var(--ease-out-expo);
  }

  .coalition-wall-link:hover {
    opacity: 1;
  }

  .coalition-wall-link:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: 4px;
    border-radius: 2px;
    opacity: 1;
  }

  .coalition-wall-logo {
    height: 56px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* ── Closing scarcity line ──────────────────────── */
  .coalition-closing {
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid rgba(184, 144, 74, 0.25);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text);
    opacity: 0.6;
    font-style: italic;
  }

  .coalition-closing-link {
    color: var(--color-earth);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    font-style: normal;
    opacity: 1;
    transition: opacity var(--duration-base);
  }

  .coalition-closing-link:hover {
    opacity: 0.75;
  }

  @media (max-width: 600px) {
    .coalition-heading {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }
    .coalition-name {
      font-size: clamp(1.4rem, 5.5vw, 2rem);
    }
    .coalition-logo {
      height: 48px;
    }
  }
</style>
