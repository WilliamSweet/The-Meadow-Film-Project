---
import { coalitionStats } from '../coalition-stats';
import { anchorPartners, wallPartners } from '../data/partners';
---
<section class="coalition" id="coalition" aria-labelledby="coalition-heading">
  <div class="container">

    <div class="coalition-header">
      <p class="coalition-eyebrow">The Founding Coalition</p>
      <h2 class="coalition-heading" id="coalition-heading">
        The organizations putting their name behind this film.
      </h2>
      <p class="coalition-intro">
        Founding partners join the movement on record — named in the film, in the
        outreach, and in every conversation this work starts. Here is who is already in.
      </p>
      <p class="coalition-stats">{coalitionStats.foundingPartners} founding partners &middot; {coalitionStats.acresPlanted} acres logged on the HNP Biodiversity Map &middot; {coalitionStats.corridorTowns}+ corridors</p>
    </div>

    <!--
      CREDITS TREATMENT — 2026-08-11.
      Was: one partner per full-width row, logo stacked over name over
      descriptor. That ran 295px per partner — 2,081px total for five —
      while the text only used 739px of a 1,200px container, leaving 461px
      of dead space on the right of every row.

      Now: a wrapped run, the way a film credits its supporters. Logos got
      BIGGER (64px -> 80px box), not smaller — the whole job of this section
      is that a visitor recognises these names and wants to be among them.
      The compression comes from killing the one-per-row stacking, not from
      hiding anybody.

      Deliberately NOT a side-by-side image/text pair: six other sections
      already use that layout and a seventh would make the page read as one
      template on repeat. Deliberately NOT a card grid — impeccable bans it.

      Descriptors dropped: the header line above already reads "5 founding
      partners · 170,000+ acres logged · 300+ corridors," which is where
      those same numbers were coming from.
    -->
    <ul class="coalition-list" aria-label="Founding coalition partners">
      {anchorPartners.map((partner) => (
        <li class="coalition-item">
          <a
            class="coalition-entry"
            href={partner.url}
            target="_blank"
            rel="noopener"
          >
            <span class="coalition-logo-slot">
              <img
                class="coalition-logo"
                src={partner.logo}
                alt={partner.logoAlt}
                loading="eager"
              />
            </span>
            <span class="coalition-name">{partner.name}</span>
          </a>
          <p class="coalition-blurb">{partner.descriptor}</p>
        </li>
      ))}
    </ul>

    {wallPartners.length > 0 && (
      <div class="coalition-wall">
        <p class="coalition-wall-label">Joined by</p>
        <ul class="coalition-wall-grid" aria-label="Founding partner organizations">
          {wallPartners.map((partner) => (
            <li class="coalition-wall-item">
              <a
                class="coalition-wall-link"
                href={partner.url}
                target="_blank"
                rel="noopener"
                title={partner.name}
              >
                <img
                  class="coalition-wall-logo"
                  src={partner.logo}
                  alt={partner.logoAlt}
                  loading="lazy"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="coalition-closing">
      More organizations in conversation &mdash;{' '}
      <a href="#founding-partner" class="coalition-closing-link">add your organization before the window closes August&nbsp;13</a>.
    </p>

  </div>
</section>

<style>
  .coalition {
    padding: var(--space-24) 0;
  }

  /* ── Header ─────────────────────────────────────── */
  .coalition-header {
    margin-bottom: var(--space-16);
  }

  .coalition-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-4);
  }

  .coalition-intro {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    opacity: 0.72;
    line-height: 1.6;
    max-width: 60ch;
    margin-bottom: var(--space-5);
    text-wrap: pretty;
  }

  .coalition-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: var(--space-4);
  }

  .coalition-stats {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-earth);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* ── List — a wrapped run, not one per row ──────────────────────────────
     flex-wrap, not grid: the entries are different widths (a wide wordmark
     vs a square husky vs a long org name) and should sit at their natural
     size rather than be forced into equal columns. Equal columns is what
     makes a logo row read as a template.                                  */
  .coalition-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-12) var(--space-16);
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-amber);
  }

  .coalition-item {
    flex: 0 1 auto;
    max-width: 300px;
    /* Anchor for the hover blurb below. */
    position: relative;
  }

  .coalition-entry {
    display: block;
    text-decoration: none;
  }

  /* ── Logo ───────────────────────────────────────────────────────────────
     A fixed-height SLOT, not a fixed-height image. These five logos have
     wildly different proportions — a wide horizontal wordmark next to a
     square icon — and sizing by image height alone makes the wordmark
     enormous and the icon tiny. The slot gives each one the same visual
     weight regardless of its shape.                                       */
  .coalition-logo-slot {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    /* 96px at five partners. Drop this one value as the roster grows —
       it is the single knob that rebalances the whole section. */
    height: 96px;
    margin-bottom: var(--space-4);
  }

  .coalition-logo {
    max-height: 100%;
    max-width: 260px;
    width: auto;
    object-fit: contain;
    object-position: left center;
    /* Full opacity. At 0.9 the NDAL mark — already a pale logo — washed out
       against the cream and read as less real than the others. A founding
       partner should never look faded on the page that thanks them. */
    opacity: 1;
    mix-blend-mode: multiply;
  }

  /* ── Name ───────────────────────────────────────────────────────────────
     Down from 40px. At 40px each name demanded its own row; at 20px five
     names fit the eye at once, which is what makes a coalition read as a
     coalition rather than a list of separate announcements.               */
  .coalition-name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-wrap: balance;
    /* Dotted underline is the affordance: it tells you there is more here
       without a "hover me" instruction or an icon. */
    border-bottom: 1px dotted rgba(28, 26, 23, 0.28);
    padding-bottom: 2px;
    transition: color var(--duration-base) var(--ease-out-expo),
                border-color var(--duration-base) var(--ease-out-expo);
  }

  .coalition-item:hover .coalition-name,
  .coalition-item:focus-within .coalition-name {
    color: var(--color-earth);
    border-bottom-color: var(--color-earth);
  }

  .coalition-entry:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: 6px;
    border-radius: 2px;
  }

  /* ── Hover blurb ────────────────────────────────────────────────────────
     What each partner actually does, revealed on hover or keyboard focus.

     OVERLAY, not inline: it is absolutely positioned so revealing it never
     reflows the row. An inline reveal would shove every other partner
     sideways the instant the cursor crossed a name — the section would
     twitch as you moved across it.

     Animates opacity and transform only — never height or max-height,
     which would force a layout recalculation on every frame.             */
  .coalition-blurb {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 5;
    width: 300px;
    max-width: 90vw;
    margin-top: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid rgba(201, 169, 110, 0.5);
    border-radius: var(--radius-sm);
    box-shadow: 0 6px 24px rgba(28, 26, 23, 0.1);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 180ms var(--ease-out-expo),
                transform 180ms var(--ease-out-expo),
                visibility 180ms;
    pointer-events: none;
  }

  .coalition-item:hover .coalition-blurb,
  .coalition-item:focus-within .coalition-blurb {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* A touch screen has no hover. Without this the blurbs would be
     unreachable on every phone and tablet — so there they simply live
     inline, always visible, no overlay and no reveal. */
  @media (hover: none) {
    .coalition-blurb {
      position: static;
      width: auto;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: none;
      border: none;
      box-shadow: none;
      padding: 0;
      margin-top: var(--space-2);
      opacity: 0.72;
    }

    .coalition-name {
      border-bottom: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coalition-blurb {
      transition: opacity 0.01ms, visibility 0.01ms;
      transform: none;
    }
  }

  /* ── Logo wall — scales to 20–30+ without crowding ─ */
  .coalition-wall {
    margin-top: var(--space-16);
    padding-top: var(--space-10);
    border-top: 1px solid rgba(184, 144, 74, 0.35);
  }

  .coalition-wall-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-8);
  }

  .coalition-wall-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-10) var(--space-8);
    align-items: center;
  }

  .coalition-wall-item {
    display: flex;
    justify-content: center;
  }

  .coalition-wall-link {
    display: block;
    line-height: 0;
    opacity: 0.72;
    transition: opacity var(--duration-base) var(--ease-out-expo);
  }

  .coalition-wall-link:hover {
    opacity: 1;
  }

  .coalition-wall-link:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: 4px;
    border-radius: 2px;
    opacity: 1;
  }

  .coalition-wall-logo {
    height: 56px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* ── Closing scarcity line ──────────────────────── */
  .coalition-closing {
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid rgba(184, 144, 74, 0.25);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text);
    opacity: 0.6;
    font-style: italic;
  }

  .coalition-closing-link {
    color: var(--color-earth);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    font-style: normal;
    opacity: 1;
    transition: opacity var(--duration-base);
  }

  .coalition-closing-link:hover {
    opacity: 0.75;
  }

  @media (max-width: 600px) {
    .coalition-heading {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }
    .coalition-name {
      font-size: clamp(1.4rem, 5.5vw, 2rem);
    }
    .coalition-logo {
      height: 48px;
    }
  }
</style>
