---
/*
  REAL SHOOT STILLS — August 5, 2026, Connecticut. These replace the stock
  meadow frames that stood in here, which in turn replaced Sleepy Cat Farm
  (dropped as a location 2026-07-27; its photos must not come back).

  Sources in ~/My Drive: IMG_4666, IMG_4662, "Steve Interview".
  Converted at 1800px wide, cwebp q82, into /images/shoot-2026-08-05/.

  These are the two properties this section names. Generic grass undersold
  both of them, and the whole point of the section is that these are real
  places belonging to real people.
*/
const slides = [
  {
    src: '/images/shoot-2026-08-05/dobbins-copper-sculpture.webp',
    alt: "Two of Paul Dobbins's copper sculptures standing in a bank of black-eyed Susans on the Dobbins property",
  },
  {
    src: '/images/shoot-2026-08-05/dobbins-maggie-paul-frame.webp',
    alt: 'Maggie and Paul Dobbins in their meadow, from the film',
  },
  {
    src: '/images/shoot-2026-08-05/steve-zatz-interview.webp',
    alt: 'Steve Zatz being interviewed on his property',
  },
];
import { responsive } from '../lib/images';
---
<section class="location" id="people" aria-labelledby="location-heading">
  <div class="container">
    <div class="location-inner">

      <div
        class="carousel"
        data-carousel
        role="group"
        aria-roledescription="carousel"
        aria-label="Photographs from the meadows in the film"
      >
        <div class="carousel-viewport">
          <!-- aria-live: without it a slide change is silent to a screen reader.
               "polite" waits for a pause rather than interrupting. -->
          <ul class="carousel-track" data-carousel-track aria-live="polite">
            {slides.map((slide, i) => (
              <li
                class="carousel-slide"
                data-carousel-slide
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${slides.length}`}
                aria-hidden={i === 0 ? 'false' : 'true'}
              >
                <img
                  class="carousel-img"
                  src={responsive(slide.src).src}
                  srcset={responsive(slide.src).srcset}
                  sizes="(min-width: 900px) 900px, 100vw"
                  alt={slide.alt}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>

          <button class="carousel-btn carousel-btn--prev" data-carousel-prev type="button" aria-label="Previous photo">
            <span aria-hidden="true">&#8249;</span>
          </button>
          <button class="carousel-btn carousel-btn--next" data-carousel-next type="button" aria-label="Next photo">
            <span aria-hidden="true">&#8250;</span>
          </button>
        </div>

        <!--
          These are not tabs. They were marked role="tablist"/role="tab", which
          promises a screen-reader user a set of tab panels to move between with
          the arrow keys — there are none, and the slides are not tabpanels. A
          reader announced "tab, 1 of 4" and then found nothing. They are plain
          buttons that change which photo shows; aria-current marks the active
          one. Simpler, and it describes what actually happens.
        -->
        <div class="carousel-dots" data-carousel-dots aria-label="Choose photo">
          {slides.map((_, i) => (
            <button
              class="carousel-dot"
              data-carousel-dot
              type="button"
              aria-label={`Show photo ${i + 1} of ${slides.length}`}
              aria-current={i === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>
      </div>

      <div class="location-text">
        <h2 class="location-heading" id="location-heading">The properties and the people on them</h2>
        <p class="location-body">
          The film travels to properties of every kind, and the people on them have
          nothing in common except what they did with their land.
        </p>

        <!--
          Two entries, not four. Doug Tallamy has his own section and Sara Weaner
          Cooper has her own story panel; naming all four here repeated them and
          made the section a summary of the page rather than a part of it.

          A real list, not bolded names inside a paragraph. Bold runs in prose ask
          the reader to read and scan at the same time, and the eye bounces —
          which is exactly what it looked like. Name, place, then the sentence.
        -->
        <ul class="subject-list">
          <li class="subject">
            <h3 class="subject-name">Steve Zatz</h3>
            <p class="subject-line">
              The former chief executive of WebMD, who built one of the most ambitious
              native landscapes in Connecticut from scratch. His line is that grass is
              &ldquo;essentially a bio-desert.&rdquo;
            </p>
          </li>
          <li class="subject">
            <h3 class="subject-name">Maggie and Paul Dobbins</h3>
            <p class="subject-line">
              Maggie and Paul moved from the Bay Area to Connecticut in 2021 and began
              restoring four and a half acres — pond, wetlands, rocky hillside, meadow.
              Maggie serves on the board of the Connecticut chapter of Wild Ones. Paul
              took up metal sculpture in 2023; his pieces now rise from the grasses he
              and Maggie planted.
            </p>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .location {
    padding: var(--space-24) 0;
  }

  .location-inner {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-16);
    align-items: center;
  }

  /* ── Carousel ───────────────────────────────────── */
  .carousel {
    position: relative;
  }

  .carousel-viewport {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 3;
    background: rgba(28, 43, 30, 0.06);
  }

  .carousel-track {
    list-style: none;
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    transition: transform 600ms var(--ease-out-expo);
  }

  .carousel-slide {
    flex: 0 0 100%;
    height: 100%;
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Arrows */
  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(247, 243, 236, 0.86);
    color: var(--color-text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(2px);
    transition: background var(--duration-base), opacity var(--duration-base);
  }

  .carousel-btn:hover {
    background: var(--color-bg);
  }

  .carousel-btn:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: 2px;
  }

  .carousel-btn--prev { left: var(--space-3); }
  .carousel-btn--next { right: var(--space-3); }

  /* Dots */
  .carousel-dots {
    display: flex;
    justify-content: center;
    /* No gap: each button is a 44px target and carries its own breathing room
       inside. A gap on top of that would push the dots visually apart.      */
    margin-top: var(--space-2);
  }

  /* The dot you see is 8px. The button you tap is 44px.
     The visible mark is drawn with a pseudo-element so the hit area can be
     full size without the dot growing to match. */
  .carousel-dot {
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(28, 43, 30, 0.25);
    transition: background var(--duration-base), transform var(--duration-base);
  }

  .carousel-dot[aria-current='true']::before {
    background: var(--color-earth);
    transform: scale(1.3);
  }

  .carousel-dot:hover::before {
    background: rgba(28, 43, 30, 0.45);
  }

  .carousel-dot:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: -8px;
    border-radius: 50%;
  }

  .carousel-dot:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: 2px;
  }

  /* ── Text ───────────────────────────────────────── */
  .location-heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: var(--space-8);
  }

  .location-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.8;
    max-width: 65ch;
  }

  .location-body + .location-body {
    margin-top: var(--space-4);
  }

  /* ── Subjects ───────────────────────────────────────────────────────────
     Same grammar as the Camera & Sound block: a straw hairline above each
     entry, the name, then one sentence. No town/state line — William asked
     for it dropped 2026-08-10. Nothing is bolded inside prose — the name
     is a heading because it IS one.                                       */
  .subject-list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
  }

  .subject {
    padding-top: var(--space-6);
    border-top: 1px solid rgba(201, 169, 110, 0.28);
  }

  .subject + .subject {
    margin-top: var(--space-6);
  }

  .subject-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.2;
    margin-top: var(--space-1);
  }

  .subject-line {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.7;
    opacity: 0.8;
    margin-top: var(--space-2);
    max-width: 52ch;
  }

  .location-link {
    color: var(--color-earth);
    text-decoration: none;
    border-bottom: 1px solid rgba(184, 144, 74, 0.5);
    transition: border-color var(--duration-base);
  }

  .location-link:hover {
    border-color: var(--color-earth);
  }

  @media (max-width: 768px) {
    .location-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-carousel]').forEach((root) => {
      const track = root.querySelector('[data-carousel-track]');
      const slides = Array.from(root.querySelectorAll('[data-carousel-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-carousel-dot]'));
      const prev = root.querySelector('[data-carousel-prev]');
      const next = root.querySelector('[data-carousel-next]');
      if (!track || slides.length === 0) return;

      let index = 0;
      const count = slides.length;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function go(n) {
        index = (n + count) % count;
        track.style.transform = `translateX(-${index * 100}%)`;
        slides.forEach((s, i) => s.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
        dots.forEach((d, i) => d.setAttribute('aria-current', i === index ? 'true' : 'false'));
      }

      prev && prev.addEventListener('click', () => { go(index - 1); restart(); });
      next && next.addEventListener('click', () => { go(index + 1); restart(); });
      dots.forEach((d, i) => d.addEventListener('click', () => { go(i); restart(); }));

      // Keyboard
      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { go(index - 1); restart(); }
        else if (e.key === 'ArrowRight') { go(index + 1); restart(); }
      });

      // Touch / swipe
      let startX = 0, dragging = false;
      track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; dragging = true; }, { passive: true });
      track.addEventListener('touchend', (e) => {
        if (!dragging) return;
        dragging = false;
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) { go(dx < 0 ? index + 1 : index - 1); restart(); }
      }, { passive: true });

      // Gentle autoplay — pauses on hover/focus, off for reduced-motion
      let timer = null;
      function start() {
        if (reduce || count < 2) return;
        timer = window.setInterval(() => go(index + 1), 6000);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function restart() { stop(); start(); }

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      go(0);
      start();
    });
  })();
</script>
