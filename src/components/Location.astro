---
// Sleepy Cat Farm carousel. Add or reorder slides here — one entry per image.
// Drop new photos into /public/images/sleepy-cat/ and add a row below.
const slides = [
  {
    src: '/images/sleepy-cat/paradiso-arch.webp',
    alt: 'Sleepy Cat Farm — perennial borders in bloom leading to the stone Paradiso arch, Greenwich, Connecticut',
  },
  {
    src: '/images/sleepy-cat/meadow-rocks.jpg',
    alt: 'Native meadow grasses and wildflowers rooting through the ledge rock at Sleepy Cat Farm',
  },
  {
    src: '/images/sleepy-cat/garden-statue.jpg',
    alt: 'Visitors walking the garden paths past a classical statue and mixed plantings at Sleepy Cat Farm',
  },
  {
    src: '/images/sleepy-cat/greenhouse-lemons.webp',
    alt: 'The timber-beamed citrus gallery at Sleepy Cat Farm, potted lemon trees under the arched ceiling',
  },
];
---
<section class="location" id="location" aria-labelledby="location-heading">
  <div class="container">
    <div class="location-inner">

      <div
        class="carousel"
        data-carousel
        role="group"
        aria-roledescription="carousel"
        aria-label="Sleepy Cat Farm photographs"
      >
        <div class="carousel-viewport">
          <ul class="carousel-track" data-carousel-track>
            {slides.map((slide, i) => (
              <li
                class="carousel-slide"
                data-carousel-slide
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${slides.length}`}
                aria-hidden={i === 0 ? 'false' : 'true'}
              >
                <img
                  class="carousel-img"
                  src={slide.src}
                  alt={slide.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </li>
            ))}
          </ul>

          <button class="carousel-btn carousel-btn--prev" data-carousel-prev type="button" aria-label="Previous photo">
            <span aria-hidden="true">&#8249;</span>
          </button>
          <button class="carousel-btn carousel-btn--next" data-carousel-next type="button" aria-label="Next photo">
            <span aria-hidden="true">&#8250;</span>
          </button>
        </div>

        <div class="carousel-dots" data-carousel-dots role="tablist" aria-label="Choose photo">
          {slides.map((_, i) => (
            <button
              class="carousel-dot"
              data-carousel-dot
              type="button"
              role="tab"
              aria-label={`Photo ${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>
      </div>

      <div class="location-text">
        <h2 class="location-heading" id="location-heading">One of the places the film visits</h2>
        <p class="location-body">
          The film travels to properties of every kind. One of them is
          <a href="https://www.sleepycatfarm.com" target="_blank" rel="noopener" class="location-link">Sleepy Cat Farm</a>,
          a thirteen-acre estate in Greenwich, Connecticut. Designed in collaboration
          with Charles J. Stick, it blends European and Asian garden influences with a
          productive organic farm and thriving native pollinator habitat. Through its
          partnership with The Garden Conservancy, it serves as an educational hub,
          hosting public tours and workshops on native wildflower propagation.
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  .location {
    padding: var(--space-24) 0;
  }

  .location-inner {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-16);
    align-items: center;
  }

  /* ── Carousel ───────────────────────────────────── */
  .carousel {
    position: relative;
  }

  .carousel-viewport {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 3;
    background: rgba(28, 43, 30, 0.06);
  }

  .carousel-track {
    list-style: none;
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    transition: transform 600ms var(--ease-out-expo);
  }

  .carousel-slide {
    flex: 0 0 100%;
    height: 100%;
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Arrows */
  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(247, 243, 236, 0.86);
    color: var(--color-text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(2px);
    transition: background var(--duration-base), opacity var(--duration-base);
  }

  .carousel-btn:hover {
    background: #F7F3EC;
  }

  .carousel-btn:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: 2px;
  }

  .carousel-btn--prev { left: var(--space-3); }
  .carousel-btn--next { right: var(--space-3); }

  /* Dots */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(28, 43, 30, 0.25);
    cursor: pointer;
    transition: background var(--duration-base), transform var(--duration-base);
  }

  .carousel-dot[aria-selected='true'] {
    background: var(--color-earth);
    transform: scale(1.3);
  }

  .carousel-dot:focus-visible {
    outline: 2px solid var(--color-earth);
    outline-offset: 2px;
  }

  /* ── Text ───────────────────────────────────────── */
  .location-heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: var(--space-8);
  }

  .location-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.8;
    max-width: 65ch;
  }

  .location-link {
    color: var(--color-earth);
    text-decoration: none;
    border-bottom: 1px solid rgba(184, 144, 74, 0.5);
    transition: border-color var(--duration-base);
  }

  .location-link:hover {
    border-color: var(--color-earth);
  }

  @media (max-width: 768px) {
    .location-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-carousel]').forEach((root) => {
      const track = root.querySelector('[data-carousel-track]');
      const slides = Array.from(root.querySelectorAll('[data-carousel-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-carousel-dot]'));
      const prev = root.querySelector('[data-carousel-prev]');
      const next = root.querySelector('[data-carousel-next]');
      if (!track || slides.length === 0) return;

      let index = 0;
      const count = slides.length;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function go(n) {
        index = (n + count) % count;
        track.style.transform = `translateX(-${index * 100}%)`;
        slides.forEach((s, i) => s.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
        dots.forEach((d, i) => d.setAttribute('aria-selected', i === index ? 'true' : 'false'));
      }

      prev && prev.addEventListener('click', () => { go(index - 1); restart(); });
      next && next.addEventListener('click', () => { go(index + 1); restart(); });
      dots.forEach((d, i) => d.addEventListener('click', () => { go(i); restart(); }));

      // Keyboard
      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { go(index - 1); restart(); }
        else if (e.key === 'ArrowRight') { go(index + 1); restart(); }
      });

      // Touch / swipe
      let startX = 0, dragging = false;
      track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; dragging = true; }, { passive: true });
      track.addEventListener('touchend', (e) => {
        if (!dragging) return;
        dragging = false;
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) { go(dx < 0 ? index + 1 : index - 1); restart(); }
      }, { passive: true });

      // Gentle autoplay — pauses on hover/focus, off for reduced-motion
      let timer = null;
      function start() {
        if (reduce || count < 2) return;
        timer = window.setInterval(() => go(index + 1), 6000);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function restart() { stop(); start(); }

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      go(0);
      start();
    });
  })();
</script>
