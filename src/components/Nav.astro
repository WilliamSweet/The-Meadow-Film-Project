---
---
<a href="#main-content" class="skip-link">Skip to main content</a>
<nav class="nav" id="nav" aria-label="Site navigation">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="meadowfilm.studio — return to top">
      <img src="/images/mark-nav.png" alt="" aria-hidden="true" width="383" height="400" class="nav-mark" />
      <span class="nav-logo-text">meadowfilm.studio</span>
    </a>

    <ul class="nav-links" role="list" aria-label="Page sections">
      <li><a href="#about"   class="nav-link" data-nav-link>About</a></li>
      <li><a href="#stories" class="nav-link" data-nav-link>Stories</a></li>
      <li><a href="#impact"  class="nav-link" data-nav-link>Impact</a></li>
      <li><a href="#team"    class="nav-link" data-nav-link>Team</a></li>
      <li><a href="#film"    class="nav-link" data-nav-link>Film</a></li>
    </ul>

    <div class="nav-actions">
      <a href="#support" class="btn nav-cta nav-cta--ghost">Support the Film</a>
      <a href="#founding-partner" class="btn btn-primary nav-cta">Join the Coalition</a>
    </div>
  </div>
</nav>

<style>
  /* ── Animatable scroll-progress token ───────────────────────────────────────
     inherits: true so .nav-logo and .nav-link children can read it           */
  @property --nav-progress {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  /* ── Base: transparent, white text — works over hero with zero JS ── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--space-4) 0;
    background-color: transparent;
    box-shadow: none;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  /* ── Logo ── */
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 900;
    letter-spacing: 0.14em;
    color: var(--color-bg);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
    position: relative;
  }

  /* ── The mark ──
     One asset, two states. The artwork is black ink on transparency, so the
     transparent-over-hero state inverts it to cream and the solid state lets
     it sit black — the same flip the wordmark makes, driven by the same
     .nav--scrolled class rather than a second image file. */
  .nav-mark {
    height: 1.5em;
    width: auto;
    flex-shrink: 0;
    filter: brightness(0) invert(1) drop-shadow(0 1px 6px rgba(0, 0, 0, 0.45));
    transition: filter var(--duration-base) var(--ease-out-expo);
  }

  .nav--scrolled .nav-mark {
    filter: none;
  }

  /* The wordmark's text box is 23px tall. On a touch screen that is a miss
     waiting to happen, so the tap area is grown to 44px with a pseudo-element
     rather than with padding — padding would move the wordmark off its
     baseline in the nav row. Touch pointers only; the mouse never needed it. */
  @media (pointer: coarse) {
    .nav-logo::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 44px;
      transform: translateY(-50%);
    }
  }

  /* ── Section links ── */
  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-8);
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    font-variant: small-caps;
    letter-spacing: 0.12em;
    color: rgba(247, 243, 236, 0.70);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-bg);
    border-bottom-color: rgba(247, 243, 236, 0.45);
    outline: none;
  }

  .nav-link--active {
    color: var(--color-bg);
    border-bottom-color: rgba(247, 243, 236, 0.55);
  }

  /* ── CTA buttons ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .nav-cta {
    padding: var(--space-2) var(--space-6);
    font-size: 0.625rem;
    flex-shrink: 0;
  }

  /* Ghost variant — the funding ask, sitting next to the coalition ask.
     One filled button pulling for two different asks would flatten the
     choice between them; this one stays quiet so "Join the Coalition"
     keeps first weight, the way it did before this button existed. */
  .nav-cta--ghost {
    background: transparent;
    border: 1px solid rgba(247, 243, 236, 0.55);
    color: var(--color-bg);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
    transition: border-color var(--duration-base) var(--ease-out-expo),
                background-color var(--duration-base) var(--ease-out-expo),
                color var(--duration-base) var(--ease-out-expo);
  }

  .nav-cta--ghost:hover,
  .nav-cta--ghost:focus-visible {
    border-color: var(--color-bg);
    background-color: rgba(247, 243, 236, 0.12);
  }

  .nav--scrolled .nav-cta--ghost {
    border-color: rgba(28, 26, 23, 0.32);
    color: var(--color-text);
    text-shadow: none;
  }

  .nav--scrolled .nav-cta--ghost:hover,
  .nav--scrolled .nav-cta--ghost:focus-visible {
    border-color: var(--color-earth);
    color: var(--color-earth);
    background-color: rgba(168, 85, 51, 0.06);
  }

  /* ── JS fallback: solid state past hero (older browsers only) ── */
  .nav--scrolled {
    background-color: var(--color-bg);
    box-shadow: 0 1px 0 var(--color-straw);
    transition:
      background-color var(--duration-base) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-out-expo);
  }

  .nav--scrolled .nav-logo {
    color: var(--color-text);
    text-shadow: none;
    transition: color var(--duration-base) var(--ease-out-expo);
  }

  .nav--scrolled .nav-link {
    color: rgba(28, 26, 23, 0.55);
    text-shadow: none;
    transition: color var(--duration-base) var(--ease-out-expo);
  }

  .nav--scrolled .nav-link:hover,
  .nav--scrolled .nav-link:focus-visible {
    color: var(--color-text);
    border-bottom-color: var(--color-earth);
  }

  .nav--scrolled .nav-link--active {
    color: var(--color-text);
    border-bottom-color: var(--color-earth);
  }

  /* ── Cinematic CSS scroll-driven transition ─────────────────────────────────
     Background only — text color is handled by JS (.nav--scrolled class)
     Supported: Chrome 115+, Safari 18+, Firefox 110+
     180px fade window centred on the hero exit (100svh)              ── */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {

      @keyframes nav-bg {
        from { --nav-progress: 0; }
        to   { --nav-progress: 1; }
      }

      .nav {
        animation: nav-bg linear both;
        animation-timeline: scroll(root);
        animation-range: calc(100svh - 120px) calc(100svh + 60px);

        background-color: color-mix(
          in srgb,
          var(--color-bg) calc(var(--nav-progress) * 100%),
          transparent
        );
        box-shadow: 0 1px 0 color-mix(
          in srgb,
          var(--color-straw) calc(var(--nav-progress) * 100%),
          transparent
        );
      }
    }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .nav-logo {
      font-size: var(--text-sm);
      letter-spacing: 0.06em;
    }

    .nav-cta {
      padding: var(--space-2) var(--space-4);
      letter-spacing: 0.04em;
    }

    /* One ask fits a phone header without crowding the logo; the donation
       ask is still one scroll away in the Support section itself. */
    .nav-cta--ghost {
      display: none;
    }
  }
</style>
